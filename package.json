{
  "name": "aidlc-ext",
  "displayName": "AIDLC — AI-Driven Development Lifecycle",
  "description": "Run AI-driven SDLC workflows (full AIDLC, docs generation, legacy migration, feature implementation) with Claude Agent SDK and human approval gates.",
  "version": "0.1.0",
  "publisher": "aidlc-ext",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aidlc",
          "title": "AIDLC",
          "icon": "media/aidlc.svg"
        }
      ]
    },
    "views": {
      "aidlc": [
        {
          "type": "webview",
          "id": "aidlc.sidebar",
          "name": "Workflows"
        },
        {
          "id": "aidlc.artifacts",
          "name": "Artifacts"
        }
      ]
    },
    "commands": [
      {
        "command": "aidlc.startWorkflow",
        "title": "AIDLC: Start Workflow"
      },
      {
        "command": "aidlc.resumeRun",
        "title": "AIDLC: Resume Run"
      },
      {
        "command": "aidlc.stopRun",
        "title": "AIDLC: Stop Run"
      },
      {
        "command": "aidlc.setApiKey",
        "title": "AIDLC: Set Anthropic API Key"
      },
      {
        "command": "aidlc.openArtifacts",
        "title": "AIDLC: Open Artifacts Folder"
      },
      {
        "command": "aidlc.refreshArtifacts",
        "title": "AIDLC: Refresh Artifacts",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aidlc.refreshArtifacts",
          "when": "view == aidlc.artifacts",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AIDLC",
      "properties": {
        "aidlc.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "Claude model used for workflow stages."
        },
        "aidlc.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Skip human approval gates (not recommended)."
        },
        "aidlc.maxTurnsPerStage": {
          "type": "number",
          "default": 40,
          "description": "Max agent turns per stage."
        },
        "aidlc.maxBudgetUsdPerStage": {
          "type": "number",
          "default": 5,
          "description": "Max spend (USD) per stage."
        },
        "aidlc.docsFolder": {
          "type": "string",
          "default": "aidlc-docs",
          "description": "Folder (relative to workspace root) for AIDLC artifacts."
        },
        "aidlc.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "bedrock",
            "vertex"
          ],
          "default": "anthropic",
          "description": "Model provider. Bedrock/Vertex use your ambient cloud credentials."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node esbuild.mjs --production && vsce package --skip-license --allow-missing-repository",
    "test:integration": "node esbuild.mjs && esbuild test-integration/suite.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --external:@anthropic-ai/claude-agent-sdk --outfile=dist-test/suite.js --log-level=warning && node test-integration/runTest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@anthropic-ai/sdk": "^0.128.0",
    "@colbymchenry/codegraph": "1.6.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
